{
  "db_name": "PostgreSQL",
  "query": "SELECT d.id AS \"id: TokenId\", d.client_id AS \"client_id: ClientId\",\n            c.display_name AS client_display_name,\n            c.owner_id AS \"client_owner_id: UserId\",\n            d.scopes AS \"scopes: JsonArray<String>\", d.audience, d.created_at, d.expires_at FROM device_authorizations d\n            JOIN oidc_clients c ON c.id = d.client_id\n            WHERE d.user_code_digest = ANY($1)\n            AND d.status = 'pending'\n            AND d.expires_at > now()\n            AND c.enabled FOR UPDATE OF d",
