{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id AS \"id: RecoveryId\", r.user_id AS \"user_id: UserId\", r.started_at,\n            r.expires_at, r.completed_at, r.passkey_id AS \"passkey_id: PasskeyId\",\n            r.settles_at, r.cancelled_at, r.undone_at, clock_timestamp() AS \"read_at!\" FROM account_recoveries r\n                WHERE r.user_id = $1 AND r.cancelled_at IS NULL AND r.undone_at IS NULL\n                ORDER BY r.started_at DESC, r.id DESC\n                LIMIT 1",
