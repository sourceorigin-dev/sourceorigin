{
  "db_name": "PostgreSQL",
  "query": "SELECT u.id AS \"id: UserId\", h.handle AS \"handle: Handle\", u.handle_changed_at,\n            u.display_name, u.profile_version AS \"profile_version: Unsigned\",\n            u.status AS \"status: AccountStatus\", u.created_at, u.updated_at,\n            p.id AS \"picture?: PictureId\" FROM users u\n            JOIN handles h ON h.user_id = u.id AND h.released_at IS NULL\n            LEFT JOIN profile_pictures p ON p.user_id = u.id AND u.status = 'active' WHERE h.handle = $1",
